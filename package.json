    "check:public": "node scripts/check-public-files.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3"
  },
  "dependencies": {
    "read-excel-file": "^9.3.13"
  }
}
