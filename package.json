{
  "name": "investment-tracking-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.js",
    "check:live": "node scripts/check-live.mjs",
    "start:e2e": "node scripts/e2e-server.mjs",
